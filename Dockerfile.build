ARG LIBC=glibc

FROM astral/uv:python3.10-alpine AS base-musl

ARG UI_BACKEND=tkinter

# Install build dependencies based on UI backend
RUN if [ "$UI_BACKEND" = "nicegui" ]; then \
        apk add --no-cache \
            build-base \
            python3-dev \
            musl-dev \
            7zip; \
    else \
        apk add --no-cache \
            build-base \
            python3-dev \
            python3-tkinter \
            libxft-dev \
            musl-dev \
            zlib-dev \
            jpeg-dev \
            freetype-dev \
            7zip \
            tk-dev \
            tcl-dev; \
    fi

FROM astral/uv:python3.10-bookworm-slim AS base-glibc

ARG UI_BACKEND=tkinter

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential binutils p7zip-full \
    && if [ "$UI_BACKEND" = "tkinter" ]; then \
        apt-get install -y --no-install-recommends \
            tk-dev tcl-dev libxft-dev zlib1g-dev libjpeg-dev libfreetype6-dev; \
    fi \
    && rm -rf /var/lib/apt/lists/*

FROM base-${LIBC} AS builder

ARG LIBC
ARG ARCH=x86_64
ARG UI_BACKEND=tkinter

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --no-cache --locked --group ${UI_BACKEND} --group build

# Copy source code
COPY . .

# Build the application
RUN UI_BACKEND=${UI_BACKEND} uv run --no-sync pyinstaller build.spec

# Show PyInstaller warnings
RUN cat build/build/warn-build.txt || true

# Create release folder and archive
RUN folder='Twitch Drops Miner' && \
    mkdir "${folder}" && \
    cp manual.txt dist/* "${folder}" && \
    7z a "Twitch.Drops.Miner.Linux.${LIBC}.PyInstaller-${UI_BACKEND}-${ARCH}.zip" "${folder}"
